 title="KV REVERSI"
 width="420">
    <!-- S24: fixed-size layout, absolute positioning - same proven scheme as
         floater_kv_blackjack.xml / floater_music_player.xml. 64 fixed board-
         cell buttons (image_unselected = plain green cell, image_overlay
         swapped at runtime to a disc texture or cleared for empty) rather
         than any dynamic widget creation. Board starts at top=72 (clears
         status_text + score_text, which previously ended at the same y the
         board started at, so the board was drawn right over score_text -
         only a sliver of it peeked out). 44px cells, no gap between cells
         (left_pad="0"/top_pad="0") so they read as one continuous 352x352
         grid. -->
    <text
     type="string"
     follows="left|top"
     height="18"
     layout="topleft"
     left="16"
     name="status_text"
     top="24"
     right="-16">
        Your move.
    </text>
    <text
     type="string"
     follows="left|top"
     height="16"
     layout="topleft"
     left="16"
     name="score_text"
     top_pad="4"
     right="-16">
        Black (you): 2   White: 2
    </text>

