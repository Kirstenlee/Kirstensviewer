     name="vfd_text"
     type="string"
     left="10"
     top="10"
     width="260"
     height="40"
     layout="topleft"
     follows="all"
     font="Monospace"
     font.size="huge"
     halign="right"
     valign="center"
     text_color="0.15 0.95 0.95 1">
      0
    </text>
  </panel>

