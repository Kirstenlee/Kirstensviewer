  <panel
   name="vfd_panel"
   follows="left|top"
   left="10"
   top="30"
   width="280"
   height="60"
   layout="topleft"
   background_visible="true"
   background_opaque="false"
   bg_alpha_image="calculator/vfd_bg.png">
