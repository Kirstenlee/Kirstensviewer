    </text>
    <text
     type="string"
     follows="top|left"
     halign="center"
     height="12"
     font="SansSerifSmall"
     layout="topleft"
     left_pad="2"
     name="eq_label_7"
     top_delta="0"
     width="26">
        12K
    </text>
    <text
     type="string"
     follows="top|left"
     halign="center"
     height="12"
     font="SansSerifSmall"
     layout="topleft"
     left_pad="2"
     name="eq_label_8"
     top_delta="0"
     width="26">
        14K
    </text>
    <text
     type="string"
     follows="top|left"
     halign="center"
     height="12"
     font="SansSerifSmall"
     layout="topleft"
     left_pad="2"
     name="eq_label_9"
     top_delta="0"
     width="26">
        16K
    </text>
    <text
     type="string"
     follows="left|top"
     height="16"
     layout="topleft"
     left="10"
     name="eq_preamp_label"
     top_pad="10"
     width="55">
        Preamp
    </text>
    <slider_bar
     follows="top|left|right"
     height="20"
     increment="1"
     initial_value="0"
     layout="topleft"
     left_pad="6"
     max_val="20"
     min_val="-20"
     name="eq_preamp_slider"
     top_delta="0"
     tool_tip="Equalizer preamp (dB)"
     right="-10" />
</floater>
