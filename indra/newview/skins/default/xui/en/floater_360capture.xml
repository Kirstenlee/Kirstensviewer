<?xml version="1.0" encoding="utf-8" standalone="yes" ?>
<floater
 positioning="centered"
 legacy_header_height="18"
 height="590"
 layout="topleft"
 name="360capture"
 help_topic="360capture"
 save_rect="true"
 title="360 SNAPSHOT"
 can_resize="false"
 width="820">

  <text
   name="instructions"
   layout="topleft"
   left="10"
   top="40"
   width="190"
   height="90"
   wrap="true"
   font="SansSerifSmall">
    Rotate your avatar through a full turn and let the scene finish loading before capturing - this reduces missing-geometry artifacts in the result.
  </text>

  <radio_group
   name="resolution_radio"
   layout="topleft"
   left="10"
   top="135"
   width="190"
   height="60">
    <radio_item
     name="res_low"
     label="Low (512)"
     value="512"
     layout="topleft"
     top="0"
     height="18" />
    <radio_item
     name="res_medium"
     label="Medium (1024)"
     value="1024"
     layout="topleft"
     top_pad="2"
     height="18" />
    <radio_item
     name="res_high"
     label="High (2048)"
     value="2048"
     layout="topleft"
     top_pad="2"
     height="18" />
  </radio_group>

  <check_box
   name="show_avatars_check"
   label="Show other avatars"
   tool_tip="Include other residents' avatars in the capture. Your own avatar is always excluded (point-blank at the poles otherwise)."
   layout="topleft"
   left="10"
   top="200"
   width="190"
   height="18" />

  <button
   name="take_snapshot_button"
   label="Take Snapshot"
   layout="topleft"
   left="10"
   top="230"
   width="190"
   height="24" />

  <text
   name="status_text"
   layout="topleft"
   left="10"
   top="260"
   width="190"
   height="16"
   font="SansSerifSmall" />

  <button
   name="save_to_disk_button"
   label="Save to Disk"
   layout="topleft"
   left="10"
   top="556"
   width="190"
   height="24" />

  <!-- S24 : raw cube faces, D3D11 slice order 0=+X,1=-X,2=+Y,3=-Y,4=+Z,5=-Z
       - not compass directions. Direct children of this floater (not a
       sub-panel) so draw()'s getRect() is already floater-local. -->
  <panel
   name="face_preview_0"
   layout="topleft"
   left="215"
   top="35"
   width="195"
   height="120"
   background_visible="true"
   bg_opaque_color="0.1 0.1 0.1 1"
   tool_tip="Face 0 (+X)" />
  <panel
   name="face_preview_1"
   layout="topleft"
   left="415"
   top="35"
   width="195"
   height="120"
   background_visible="true"
   bg_opaque_color="0.1 0.1 0.1 1"
   tool_tip="Face 1 (-X)" />
  <panel
   name="face_preview_2"
   layout="topleft"
   left="615"
   top="35"
   width="195"
   height="120"
   background_visible="true"
   bg_opaque_color="0.1 0.1 0.1 1"
   tool_tip="Face 2 (+Y)" />
  <panel
   name="face_preview_3"
   layout="topleft"
   left="215"
   top="160"
   width="195"
   height="120"
   background_visible="true"
   bg_opaque_color="0.1 0.1 0.1 1"
   tool_tip="Face 3 (-Y)" />
  <panel
   name="face_preview_4"
   layout="topleft"
   left="415"
   top="160"
   width="195"
   height="120"
   background_visible="true"
   bg_opaque_color="0.1 0.1 0.1 1"
   tool_tip="Face 4 (+Z, up)" />
  <panel
   name="face_preview_5"
   layout="topleft"
   left="615"
   top="160"
   width="195"
   height="120"
   background_visible="true"
   bg_opaque_color="0.1 0.1 0.1 1"
   tool_tip="Face 5 (-Z, down)" />

  <panel
   name="equirect_preview"
   layout="topleft"
   left="215"
   top="285"
   width="595"
   height="295"
   background_visible="true"
   bg_opaque_color="0.05 0.05 0.05 1"
   tool_tip="Stitched equirectangular result" />

</floater>
