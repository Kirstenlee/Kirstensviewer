<?xml version="1.0" encoding="utf-8" standalone="yes" ?>
<floater
 legacy_header_height="18"
 can_resize="false"
 height="600"
 layout="topleft"
 name="kv_solitaire"
 help_topic="kv_solitaire"
 save_rect="true"
 title="KV SOLITAIRE"
 width="500">
    <!-- S24: fixed-size layout, absolute positioning - same proven scheme as
         floater_kv_blackjack.xml / floater_kv_reversi.xml. Reuses the real
         card textures built for KV Blackjack (cards/*.png), plus one new
         small placeholder (cards/empty_slot.png) for an empty pile
         position. Cards sized 60x88 (20% bigger than the first draft, per
         user feedback that 50x73 read as tiny). Tableau cards use ABSOLUTE
         top values (not top_pad chaining) so each column fans out with a
         19px overlap per card - top_pad only ever adds space, it can't
         produce the negative offset a card fan needs. Click model: click a
         card to select it (gold highlight) - this picks up that card AND
         everything stacked above it as one movable run - then click a
         column or foundation to attempt the move, or click it again to
         deselect. Double-click a column/waste's own top card to auto-send
         it to a foundation if one will take it. Clicking Stock draws 3 (or
         recycles the waste when empty). -->
    <text
     type="string"
     follows="left|top"
     height="22"
     layout="topleft"
     left="19"
     name="status_text"
     top="29"
     right="-19">
        New deal.
    </text>
    <text
     type="string"
     follows="left|top"
     halign="center"
     height="19"
     layout="topleft"
     left="19"
     name="stats_text"
     top_pad="5"
     right="-19">
        Score: 0   Best: 0   Played: 0   Won: 0
    </text>

    <!-- S24: baize drawn as a plain background panel behind the card area,
         not a container - every button below keeps its existing absolute
         floater-relative coordinates untouched. Reuses the same
         kv_blackjack_baize.png texture as KV Blackjack for a consistent
         look across all the card games. -->
