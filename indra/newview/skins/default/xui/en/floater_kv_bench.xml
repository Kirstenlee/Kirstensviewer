<?xml version="1.0" encoding="utf-8" standalone="yes" ?>
<floater
 legacy_header_height="18"
 can_resize="false"
 height="386"
 layout="topleft"
 name="kv_bench"
 help_topic="kv_bench"
 save_rect="true"
 title="KV BENCH"
 width="400">
    <!-- S24: VFD-glass panel look reused from floater_kv_calculator.xml
         (bench/score_panel.png, bench/gfx_panel.png - same generation
         technique as calculator/vfd_bg.png, just resized). The gfx_panel
         below is also where KVFloaterBench::draw() draws its quad-batch
         stress test directly (dx_rect_2d) while the Graphics sub-test is
         running - no XUI children needed inside it for that. -->
    <panel
     name="score_panel"
     follows="left|top"
     left="20"
     top="20"
     width="360"
     height="72"
     layout="topleft"
     background_visible="true"
     background_opaque="false"
     bg_alpha_image="bench/score_panel.png">
        <text
         name="score_text"
         type="string"
         left="10"
         top="6"
         width="340"
         height="36"
         layout="topleft"
         follows="all"
         font="Monospace"
         font.size="Huge"
         halign="center"
         valign="center"
         text_color="0.15 0.95 0.95 1">
            --- Kmarks
        </text>
        <text
         name="compare_text"
         type="string"
         left="10"
         top_pad="2"
         width="340"
         height="18"
         layout="topleft"
         follows="left|top"
         halign="center"
         text_color="0.5 0.85 0.85 1">

        </text>
    </panel>

    <panel
     name="gfx_panel"
     follows="left|top"
     left="20"
     top_pad="10"
     width="360"
     height="150"
     layout="topleft"
     background_visible="true"
     background_opaque="false"
     bg_alpha_image="bench/gfx_panel.png" />

    <text
     type="string"
     follows="left|top"
     halign="center"
     height="18"
     layout="topleft"
     left="20"
     name="status_text"
     top_pad="10"
     width="360">
        Click Run Benchmark to start.
    </text>

    <text
     type="string"
     follows="left|top"
     halign="center"
     height="16"
     layout="topleft"
     left="20"
     name="detail_text"
     top_pad="6"
     width="360"
     text_color="0.6 0.6 0.6 1">

    </text>

    <text
     type="string"
     follows="left|top"
     halign="center"
     height="16"
     layout="topleft"
     left="20"
     name="detail_text2"
     top_pad="2"
     width="360"
     text_color="0.6 0.6 0.6 1">

    </text>

    <button
     follows="left|top"
     height="28"
     label="Run Benchmark"
     layout="topleft"
     left="125"
     name="run_btn"
     top_pad="12"
     width="150" />
</floater>
