<settings_files>
  <group name="Default"
         path_index="2">
    <!-- S24: the monolithic settings.xml (19.5k lines, 1739 settings) was split into category
         .ini files for readability/parse-time/grep-ability. All loaded into the same "Global"
         LLControlGroup as before (same mechanism this file already used for e.g. the 3
         "Skinning" entries below), so gSavedSettings lookups are completely unaffected by which
         file a setting's definition lives in. Confirmed working with settings.xml genuinely
         absent (not just dereferenced) before it was retired for real - svn history is the
         rollback reference, not a kept-around copy. complex_settings.xml is the sidecar for the
         11 settings whose value is genuinely complex LLSD (not a plain scalar or fixed-arity
         tuple) - kept as plain LLSD-XML rather than forced into the .ini dialect. -->
    <file name="Global" file_name="complex_settings.xml" required="true"/>
    <file name="Global" file_name="audio.ini" required="true"/>
    <file name="Global" file_name="avatar.ini" required="true"/>
    <file name="Global" file_name="beacons.ini" required="true"/>
    <file name="Global" file_name="browser.ini" required="true"/>
    <file name="Global" file_name="build.ini" required="true"/>
    <file name="Global" file_name="camera.ini" required="true"/>
    <file name="Global" file_name="chat.ini" required="true"/>
    <file name="Global" file_name="debug.ini" required="true"/>
    <file name="Global" file_name="environment.ini" required="true"/>
    <file name="Global" file_name="inventory.ini" required="true"/>
    <file name="Global" file_name="krlv.ini" required="true"/>
    <file name="Global" file_name="kv.ini" required="true"/>
    <file name="Global" file_name="login_startup.ini" required="true"/>
    <file name="Global" file_name="map_grid.ini" required="true"/>
    <file name="Global" file_name="marketplace.ini" required="true"/>
    <file name="Global" file_name="media.ini" required="true"/>
    <file name="Global" file_name="mesh.ini" required="true"/>
    <file name="Global" file_name="misc.ini" required="true"/>
    <file name="Global" file_name="notifications.ini" required="true"/>
    <file name="Global" file_name="pathfinding.ini" required="true"/>
    <file name="Global" file_name="permissions.ini" required="true"/>
    <file name="Global" file_name="render_core.ini" required="true"/>
    <file name="Global" file_name="render_fsr.ini" required="true"/>
    <file name="Global" file_name="render_reflections.ini" required="true"/>
    <file name="Global" file_name="render_shadows.ini" required="true"/>
    <file name="Global" file_name="render_water.ini" required="true"/>
    <file name="Global" file_name="scene_loading.ini" required="true"/>
    <file name="Global" file_name="scripting.ini" required="true"/>
    <file name="Global" file_name="selection_editing.ini" required="true"/>
    <file name="Global" file_name="snapshot.ini" required="true"/>
    <file name="Global" file_name="stats_perf.ini" required="true"/>
    <file name="Global" file_name="terrain.ini" required="true"/>
    <file name="Global" file_name="texture_cache.ini" required="true"/>
    <file name="Global" file_name="ui.ini" required="true"/>
    <file name="Global" file_name="urls.ini" required="true"/>
    <file name="Global" file_name="vr_stereo.ini" required="true"/>
    <file name="Global" file_name="window.ini" required="true"/>
    <!-- S24: Removed settings_install.xml - Kirsten's S24 does not use LL auto-updater
         We respect users and do not automate installs or phone home with crash reports -->
    <!-- S24: PerAccount/Warnings default-definition files also converted to S24's .ini dialect,
         same mechanism and same reasoning as Global's split above. -->
    <file name="PerAccount"
          file_name="settings_per_account.ini"
          required="true"/>
    <!-- S24: Removed settings_crash_behavior.xml - Kirsten's S24 does not use LL crash reporter
         We respect user privacy and do not send automated crash reports -->
    <file name="Warnings"
          file_name="ignorable_dialogs.ini"
          required="true"/>
  </group>
  <group name="User"
         path_index="1">
    <file name="Global"
          file_name="settings.xml"
          file_name_setting="ClientSettingsFile"/>
    <!-- S24: Removed user crash settings override - not applicable without LL crash reporter -->
    <file name="Warnings"
          file_name="ignorable_dialogs.xml"
          file_name_setting="WarningSettingsFile"/>
  </group>
  <group name="Account"
         path_index="3">
    <file name="PerAccount"
          file_name="settings_per_account.xml"
          file_name_setting="PerAccountSettingsFile"/>
  </group>
  <group name="Session"
         path_index="2">
      <file name="Global"
            file_name="session.xml" 
            file_name_setting="SessionSettingsFile"
            persistent="false"/>
  </group>
  <group name="UserSession"
         path_index="1">
    <file name="Global"
          file_name="session.xml" 
          file_name_setting="UserSessionSettingsFile"
          persistent="false"/>
  </group>
  <group name="DefaultSkin"
         path_index="17">
    <file name="Skinning"
          file_name="colors.xml"/>
  </group>
  <group name="CurrentSkin"
         path_index="10">
    <file name="Skinning"
          file_name="colors.xml"/>
  </group>
  <group name="UserSkin"
         path_index="14">
    <file name="Skinning"
          file_name="colors.xml"
          file_name_setting="SkinningSettingsFile"/>
  </group>
</settings_files>
